      <column caption='Aefi' datatype='real' name='[AEFI]' role='measure' type='quantitative' />
      <column caption='States' datatype='string' name='[Calculation_0074819956043776]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
        <calculation class='tableau' formula='IF [State/UnionTerritory] = &quot;Maharashtra***&quot; THEN &quot;Maharashtra&quot;&#13;&#10;ELSEIF [State/UnionTerritory] = &quot;Karanataka&quot; THEN &quot;Karnataka&quot;&#13;&#10;ELSEIF [State/UnionTerritory] = &quot;Madhya Pradesh***&quot; THEN &quot;Madhya Pradesh&quot;&#13;&#10;ELSEIF [State/UnionTerritory] = &quot;Bihar****&quot; THEN &quot;Bihar&quot;&#13;&#10;ELSEIF [State/UnionTerritory] = &quot;Telengana&quot; THEN &quot;Telangana&quot;&#13;&#10;ELSE [State/UnionTerritory]&#13;&#10;END' />
      </column>
      <column caption='Second Dose Completion Rate (%)' datatype='real' name='[Calculation_0334027426193408]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([Second Dose Administered]) / MAX([First Dose Administered])' />
      </column>
      <column caption='Total Confirmed Cases' datatype='integer' name='[Calculation_0334027434164225]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State/UnionTerritory] : MAX([Confirmed]) }' />
      </column>
      <column caption='Total Cured Cases' datatype='integer' name='[Calculation_0334027434455042]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State/UnionTerritory] : MAX([Cured]) }' />
      </column>
      <column caption='Total Vaccinations' datatype='real' name='[Calculation_0334027434692611]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : MAX([Total Doses Administered]) }' />
      </column>
      <column caption='Total Samples Tested' datatype='real' name='[Calculation_0334027434942468]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : MAX([TotalSamples]) }' />
      </column>
      <column caption='Total Doses LOD' datatype='real' name='[Calculation_0334027439407109]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : MAX([Total Doses Administered]) }' />
      </column>
      <column caption='Total Samples LOD' datatype='real' name='[Calculation_0334027439624198]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : MAX([TotalSamples]) }' />
      </column>
      <column caption='Active Cases ' datatype='integer' name='[Calculation_2606162477707266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Confirmed]-[Cured]-[Deaths]' />
      </column>
      <column caption='Dynamic Metric Value' datatype='real' name='[Calculation_2606162478071811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 2606162472939520]&#13;&#10;  WHEN &apos;Confirmed&apos; THEN SUM([Confirmed])&#13;&#10;  WHEN &apos;Deaths&apos; THEN SUM([Deaths])&#13;&#10;  WHEN &apos;Cured&apos; THEN SUM([Cured])&#13;&#10;  WHEN &apos;Vaccines&apos; THEN SUM([Total Doses Administered])&#13;&#10;  WHEN &apos;Tests&apos; THEN SUM([TotalSamples])&#13;&#10;END' />
      </column>
      <column caption='Recovery Rate' datatype='real' default-format='p0.00%' name='[Calculation_2606162478825477]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Cured]) / SUM([Confirmed])' />
      </column>
      <column caption='Mortality Rate' datatype='real' default-format='p0.00%' name='[Calculation_2606162479226886]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Deaths]) / SUM([Confirmed])' />
      </column>
      <column caption='Daily New Deaths' datatype='integer' name='[Calculation_2606162551427082]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(MAX([Deaths])) - LOOKUP(ZN(MAX([Deaths])), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Daily New Confirmed' datatype='integer' name='[Calculation_2606162551656459]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(MAX([Confirmed])) - LOOKUP(ZN(MAX([Confirmed])), -1)'>
